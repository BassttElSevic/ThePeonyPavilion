{
	// 受损核心——牡丹亭科技树根节点
	// 设计来源（设计文档"特殊"节）：受损的主舰核心，已丧失大部分功能
	"health": 800,
	"size": 3,
	"itemCapacity": 2000,
	"unitCapModifier": 4,
	// 已丧失大部分功能：configurable = false 表示点击核心不打开核心界面，
	// 因此无法从它发射、生产单位、查看科技（发射入口在核心界面里）。
	// 物品存取需通过装卸器（与文档中仓库的设计一致）。
	"configurable": false,
	// 不可建造：不出现在建造菜单，只能由地图/星区预设开局放置
	"buildVisibility": "hidden",
	// 科技树：牡丹亭独立树的根节点（开局即有，从这里开始研究一切）
	"research": {
		"root": true,
		"name": "牡丹亭",
		"planet": "peony-pavilion"
	}
}
