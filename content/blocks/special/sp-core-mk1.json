{
	// I型核心（繁星核心链第一级）
	// 设计来源（设计文档"特殊"节）：从数据库中复原的基础型核心，
	// 用于整合开发行星各区域的资源，同时清扫可能存在的威胁。
	// 与受损核心不同：它是正常核心（可发射、可生产单位、有核心界面）。

	"health": 1200,
	"size": 3,
	"itemCapacity": 5000,
	"unitCapModifier": 8,

	// 建造分类与可见性：
	// category: effect = 原版核心的分类（Blocks.java 里 core-shard 用的）
	// buildVisibility: coreZoneOnly = 只能在"核心区域"内建造
	//   —— 受损核心（CoreBlock）周围会自动形成核心区域，
	//      所以玩家是在受损核心的位置"替换"出 I 型核心（符合设计）。
	"category": "effect",
	"buildVisibility": "coreZoneOnly",
	// 建造材料（设计文档：1000铁 1000铅；用繁星自己的铁和铅变种）
	"requirements": ["iron/1000", "sp-lead/1000"],

	// 核心链第一级（II型核心在其上升级，isFirstTier 标记）
	"isFirstTier": true,

	// 科技树：挂在硅（计算/电子原料）下。
	// 过渡选择：等数据链（computer-chip/data-unit）的 JSON 补上后，
	// 应改挂到数据链上（文档：数据单元"用于复原数据库内的科技"）。
	"research": {
		"parent": "sp-silicon"
	}
}
